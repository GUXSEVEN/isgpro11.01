# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EMAILJS CONFIGURATION FOR PASSWORD RESET, LICENSING, AND CONTACT FORM
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_LICENSE_TEMPLATE_ID=
EMAILJS_CONTACT_TEMPLATE_ID=

# PAYTR SECURE PAYMENT GATEWAY CONFIGURATION
# Get these keys from your PayTR Merchant Panel -> Settings -> API Integration
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

# DIRECT SMTP/NODEMAILER CONFIGURATION (Alternative to EmailJS)
# Use these to send email directly via GSuite/Gmail/Kurumsal mail using an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=infoisgpro@gmail.com
SMTP_PASS=
SMTP_FROM_NAME=İSG Pro

