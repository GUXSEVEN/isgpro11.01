# GEMINI AI CONFIGURATION
# Gemini API anahtarı - Yapay zeka risk değerlendirme modülü için zorunludur.
# Google AI Studio üzerinden alınabilir: https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APPLICATION PUBLIC URL (İsteğe Bağlı / Otomatik Algılanır)
# Vercel üzerinde VERCEL_URL veya VERCEL_PROJECT_PRODUCTION_URL otomatik kullanılır.
# Özel bir alan adınız varsa buraya girebilirsiniz (örn: https://isgpro.com).
APP_URL=

# PAYTR GÜVENLİ ÖDEME SANAL POS AYARLARI
# PayTR Mağaza Paneli -> Ayarlar -> API Entegrasyon Bilgileri alanından alınır.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# 1 = Canlı Test Modu, 0 = Gerçek Üretim Modu
PAYTR_TEST_MODE=1
# İsteğe bağlı özel domain (örn: isgpro.com)
PAYTR_CUSTOM_DOMAIN=

# SMTP / E-POSTA BİLDİRİM SUNUCUSU AYARLARI
# Lisans anahtarları, OTP kodları ve onaylı sözleşme PDF nüshaları bu hesap üzerinden iletilir.
# Gmail kullanıyorsanız Google Hesap -> Güvenlik -> 2 Adımlı Doğrulama -> Uygulama Şifreleri (App Password) oluşturun.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=infoisgpro@gmail.com
SMTP_PASS=
SMTP_FROM_NAME=İSG Pro

# REST API E-POSTA SERVİSLERİ (Yedek / Alternatif)
# Vercel Serverless ortamında REST API e-posta gönderimi için (isteğe bağlı):
RESEND_API_KEY=
BREVO_API_KEY=

# FIREBASE CONFIGURATION (İsteğe Bağlı - Varsayılanlar Kod İçinde Tanımlıdır)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
