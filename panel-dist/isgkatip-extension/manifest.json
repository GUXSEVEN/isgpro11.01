{
  "manifest_version": 3,
  "name": "İSGPRO İSG-KATİP Akıllı Asistanı",
  "version": "5.5.2",
  "description": "İSG-KATİP Bakanlık sunucusundan firma ve sözleşme bilgilerini (Ticari Unvan, SGK Kodu, NACE, Çalışan Sayısı, Tehlike Sınıfı, Süreler) çekip kendi uygulamanıza otomatik aktaran asistan.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://isgkatip.csgb.gov.tr/*",
    "https://*.csgb.gov.tr/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}